{
  "name": "idevflow-poster-maker",
  "version": "1.0.0",
  "private": true,
  "description": "iDevFlow 效能平台运营海报制作 Web 产品",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "start": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test && vite build"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.32",
    "@ai-sdk/replicate": "^3.0.24",
    "ai": "^7.0.55",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "jsdom": "^30.0.1",
    "typescript": "6.0.3",
    "vite": "4.5.14",
    "vitest": "^1.6.1"
  }
}
