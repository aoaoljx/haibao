# 复制为 .env 后填入真实密钥。.env 已在 .gitignore 内，不要提交。
#
# 注意：密钥变量**不能加 VITE_ 前缀**。
# vite 会把 VITE_ 开头的变量静态替换进客户端包，加了前缀等于把密钥
# 打进 dist/assets/index-*.js，任何打开页面的人都能拿到。
# 无前缀的变量只有 vite 服务端进程读得到，转发请求时注入到鉴权头，
# 浏览器发出的请求本身不带任何凭据。
#
# 改完 .env 需要重启 vite 才生效。


# ============================================================
# 目前真正可用的模型（填了就能在界面上选到并出图）
# ============================================================

# 阿里云百炼 · 千问文生图  https://bailian.console.aliyun.com/
#   境内可直连；不产透明底，系统会自动做客户端去背。
#   尺寸有 5 种比例可选，对海报右侧的窄幅槽位比 gpt-image 更贴合。
DASHSCOPE_API_KEY=

# OpenAI · gpt-image  https://platform.openai.com/api-keys
#   原生输出透明底 PNG，不需要去背，图形边缘更干净。
#   但只有 3 种尺寸，窄幅槽位上图形会偏小。
OPENAI_API_KEY=


# ============================================================
# 以下尚未接入适配器 —— 填了也不会出现在界面上
# ============================================================
# 这几个 Provider 只在注册表里占位，调用会抛
# "adapter is not connected yet"。界面会主动把它们过滤掉，
# 并提示"已配置但尚未支持"，不会让你选中一个点了必报错的模型。
#
# 要启用其中某个，需要：
#   1. 在对应的 providers/<name>.ts 里实现真实的 generateImage()
#   2. 把该 Provider 定义里的 implemented 改为 true
#   3. 核对 providers/apiProxyMap.ts 里它的 authHeader 头名是否正确
# providers/registry.test.ts 会校验 implemented 标记与真实情况一致。

# GEMINI_API_KEY=
# BFL_API_KEY=
# IDEOGRAM_API_KEY=

# ComfyUI 与 SDXL 是自建服务，需要的是地址而非密钥，
# 当前没有对应的 env 项，接入时一并设计。


# ============================================================
# 非机密调节项 —— VITE_ 前缀表示允许进入客户端
# ============================================================

# 千问：是否让模型智能改写提示词（true 会改变出图风格，默认 false）
VITE_QWEN_PROMPT_EXTEND=false
# 千问：是否在图片右下角加水印（海报用途请保持 false）
VITE_QWEN_WATERMARK=false
